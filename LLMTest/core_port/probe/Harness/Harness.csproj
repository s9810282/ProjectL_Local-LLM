<Project Sdk="Microsoft.NET.Sdk">
  <!-- 측정 전용(LLMTest/core_port/probe/README.md). 계획 하나의 할당·시간을 Core 함수 안과 우리 코드로 나눈다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ProjectL.Tests.Core</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0162;CS0168;CS0219;CS0414;CS0649;CS1998;CS8632;NU1701</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../../../Assets/Tests/EditMode/*.cs" />
    <Compile Include="ProbeMain.cs" />
    <ProjectReference Include="../../harness/Contracts/Contracts.csproj" />
    <ProjectReference Include="../../harness/Domain/Domain.csproj" />
    <ProjectReference Include="../Application/Application.csproj" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnitLite" Version="3.14.0" />
  </ItemGroup>
</Project>
