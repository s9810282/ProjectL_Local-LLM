<Project Sdk="Microsoft.NET.Sdk">
  <!-- 측정 전용(LLMTest/core_port/probe/README.md). Core 소스는 그대로, 계획 AI는 instrument.py가 만든 사본(probe/planner)을 묶는다. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ProjectL.Core.Application</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0162;CS0168;CS0219;CS0414;CS0649;CS1998;CS8632;NU1701</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../../../Assets/ProjectL/Script/Systems/RuntimeSystem/InGameSystem/CoreSystem/CoreCaculator/Application/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../planner/*.cs" />
    <ProjectReference Include="../../harness/Contracts/Contracts.csproj" />
    <ProjectReference Include="../../harness/Domain/Domain.csproj" />
  </ItemGroup>
</Project>
