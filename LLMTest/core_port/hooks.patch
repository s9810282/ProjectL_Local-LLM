+            }
+            catch (ArgumentOutOfRangeException exception)
+            {
+                throw new InvalidOperationException($"[EnemyTurnPlannerPreset {name}] {exception.ParamName} 값이 범위를 벗어났습니다.", exception);
+            }
+        }
+    }
