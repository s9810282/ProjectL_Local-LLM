<Project Sdk="Microsoft.NET.Sdk">
  <!-- 람다 걷기 측정용 사본(LLMTest/core_port/nolambda/README.md). Unity 밖에서 Core 소스를 그대로 묶어 빌드한다. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ProjectL.Core.Domain</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0162;CS0168;CS0219;CS0414;CS0649;CS1998;CS8632;NU1701</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../src/Domain/**/*.cs" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
  </ItemGroup>
</Project>
