<Project Sdk="Microsoft.NET.Sdk">
  <!-- 람다 걷기 측정용 사본(LLMTest/core_port/nolambda/README.md). Unity 밖에서 Core 소스를 그대로 묶어 빌드한다. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ProjectL.Core.Application</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0162;CS0168;CS0219;CS0414;CS0649;CS1998;CS8632;NU1701</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../src/Application/**/*.cs" />
    <!-- Editor 폴더(Unity 에디터 전용 스크립트)는 Unity 밖에서 빌드할 수 없어 뺀다. -->
    <Compile Include="$(MSBuildThisFileDirectory)../../../../Assets/ResearchEnemyPlanner/**/*.cs"
             Exclude="$(MSBuildThisFileDirectory)../../../../Assets/ResearchEnemyPlanner/Editor/**/*.cs;$(MSBuildThisFileDirectory)../../../../Assets/ResearchEnemyPlanner/Runtime/**/*.cs" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <ProjectReference Include="../Domain/Domain.csproj" />
  </ItemGroup>
</Project>
