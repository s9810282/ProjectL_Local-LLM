  traitVisualData:
    key: 540
    displayName: "가시 폭탄"
    icon: {fileID: 21300000, guid: 5b7681cdc68f04245ab7eb9361e9d7b0, type: 3}
    description: "기본 공격이 닿은 중심 칸의 생존 유닛에게 가시 폭탄을 부착합니다. 폭탄은 공격이나 다른 가시 폭탄에 맞거나, 부착한 진영의 다음 턴이 시작될 때 폭발합니다. 중심과 주변의 피아 모두에게 부착 시 공격력의 {피해율}%만큼 방어력과 상성을 무시하는 피해를 주고, 주변 유닛을 바깥으로 1칸 밀어냅니다."
    attachmentPrefab: {fileID: 1469355182125402400, guid: 46ae341f6d8a0424bb84e60a3cb79ed3, type: 3}
