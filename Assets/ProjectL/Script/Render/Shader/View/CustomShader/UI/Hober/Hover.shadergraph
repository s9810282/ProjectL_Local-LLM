{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "f96878481d1a4fcab0ca9facbfdaacda",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "UIThicknessPulse (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1460.0,
            "y": 1330.0,
            "width": 260.0,
            "height": 230.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "a8a41fc45fa44be6ae4899ec2e757fc8"
        },
        {
            "m_Id": "89ad3b0b9b3a4873954ae7fedc9cc73a"
        },
        {
            "m_Id": "72dbb57646254db88beca5e9011db622"
        },
        {
            "m_Id": "4ba009dee38d41ddbd7eaf8eba2ca356"
        },
        {
            "m_Id": "de45a79965554e17ae1ac72094d8b496"
        },
        {
            "m_Id": "7054bc50c408417f8639c30391c90016"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "UIThicknessPulse",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "// 두께 전체가 Min과 Max 사이를 같은 위상으로 왕복합니다.\n// Speed는 초당 왕복 횟수이며 0이면 Min으로 고정합니다.\nfloat lower = clamp(min(Minimum, Maximum), 0.0, 12.0);\nfloat upper = clamp(max(Minimum, Maximum), lower, 12.0);\nfloat phase = TimeSeconds * max(Speed, 0.0) * 6.28318530718 - 1.57079632679;\n// 두께와 색상은 동일한 왕복 비율을 공유합니다.\nBlend = saturate(0.5 + 0.5 * sin(phase));\nThickness = lerp(lower, upper, Blend);"
}

