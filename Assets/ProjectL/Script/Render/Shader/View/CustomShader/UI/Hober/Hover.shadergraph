    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "UIOutlineThickness",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "// 화면 픽셀 기준으로 원본의 어두운 테두리를 확장합니다.\n// 원본 알파를 유지하므로 강조는 카드 안쪽에만 표시됩니다.\nconst int maxRadius = 12;\nfloat width = clamp(Thickness, 0.0, (float)maxRadius);\nfloat2 pixelX = ddx(UV);\nfloat2 pixelY = ddy(UV);\nfloat ink = 0.0;\n[unroll]\nfor (int ring = 1; ring <= maxRadius; ++ring)\n{\n    // 한 픽셀 간격으로 채워 두꺼울 때도 선이 갈라지지 않게 합니다.\n    if (width > (float)(ring - 1))\n    {\n        float radius = min(width, (float)ring);\n        float2 dx = pixelX * radius;\n        float2 dy = pixelY * radius;\n        float4 tap;\n        tap = SAMPLE_TEXTURE2D_GRAD(SourceTexture.tex, SourceTexture.samplerstate, UV + dx, pixelX, pixelY);\n        ink = max(ink, saturate(1.0 - tap.r) * tap.a);\n        tap = SAMPLE_TEXTURE2D_GRAD(SourceTexture.tex, SourceTexture.samplerstate, UV + -dx, pixelX, pixelY);\n        ink = max(ink, saturate(1.0 - tap.r) * tap.a);\n        tap = SAMPLE_TEXTURE2D_GRAD(SourceTexture.tex, SourceTexture.samplerstate, UV + dy, pixelX, pixelY);\n        ink = max(ink, saturate(1.0 - tap.r) * tap.a);\n        tap = SAMPLE_TEXTURE2D_GRAD(SourceTexture.tex, SourceTexture.samplerstate, UV + -dy, pixelX, pixelY);\n        ink = max(ink, saturate(1.0 - tap.r) * tap.a);\n        tap = SAMPLE_TEXTURE2D_GRAD(SourceTexture.tex, SourceTexture.samplerstate, UV + (dx + dy) * 0.70710678, pixelX, pixelY);\n        ink = max(ink, saturate(1.0 - tap.r) * tap.a);\n        tap = SAMPLE_TEXTURE2D_GRAD(SourceTexture.tex, SourceTexture.samplerstate, UV + (dx - dy) * 0.70710678, pixelX, pixelY);\n        ink = max(ink, saturate(1.0 - tap.r) * tap.a);\n        tap = SAMPLE_TEXTURE2D_GRAD(SourceTexture.tex, SourceTexture.samplerstate, UV + (-dx + dy) * 0.70710678, pixelX, pixelY);\n        ink = max(ink, saturate(1.0 - tap.r) * tap.a);\n        tap = SAMPLE_TEXTURE2D_GRAD(SourceTexture.tex, SourceTexture.samplerstate, UV + (-dx - dy) * 0.70710678, pixelX, pixelY);\n        ink = max(ink, saturate(1.0 - tap.r) * tap.a);\n    }\n}\nMask = max(BaseMask, ink * ink);"
}

