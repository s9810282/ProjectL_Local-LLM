// ProjectLShaderComposerRecipe: 
Shader "Custom/ProjectLBaseLit"
{
    Properties
    {
        _BaseColor ("기본색", Color) = (1,1,1,1)
        [NoScaleOffset] _BaseMap ("기본 텍스처", 2D) = "white" {}
        _BaseUV ("텍스처 타일링/이동", Vector) = (1,1,0,0)
        _Model_Power ("모델 1 / 명암 곡선", Range(0.1,8)) = 2
        _Model_Ambient ("모델 1 / 환경광 강도", Range(0,1)) = 0.15
        _Model_Weight ("모델 1 / 혼합 가중치", Range(0,1)) = 1
        [HDR] _Fx0_Color ("효과 1 / 림 색", Color) = (1,1,1,1)
        _Fx0_Intensity ("효과 1 / 림 강도", Range(0,20)) = 9
        _Fx0_Power ("효과 1 / 림 폭", Range(0.1,12)) = 12
        _Mask0_Threshold ("효과 1 / 마스크 / 기준 밝기", Range(0,8)) = 0
        _Mask0_Softness ("효과 1 / 마스크 / 경계 부드러움", Range(0,2)) = 2
        [Toggle] _Mask0_Invert ("효과 1 / 마스크 / 반전", Float) = 0
        [HideInInspector] _SrcBlend ("Source Blend", Float) = 1
        [HideInInspector] _DstBlend ("Destination Blend", Float) = 0
        [HideInInspector] _SrcBlendAlpha ("Source Alpha Blend", Float) = 1
        [HideInInspector] _DstBlendAlpha ("Destination Alpha Blend", Float) = 0
        [HideInInspector] _ZWrite ("Depth Write", Float) = 1
    }
    SubShader
    {
        Tags { "RenderPipeline"="UniversalPipeline" "RenderType"="Opaque" "Queue"="Geometry" "ProjectLMovementTransparency"="True" }
        HLSLINCLUDE
        #define PROJECTL_COMPOSER_DISABLE_FOG 1
        #define PROJECTL_COMPOSER_LIGHT_MASK 1
        #include "Assets/ProjectL/Script/Render/Shader/Core/Includes/Composer/ComposerLighting.hlsl"
        CBUFFER_START(UnityPerMaterial)
            float4 _BaseColor;
            float4 _BaseUV;
            float _Model_Power;
            float _Model_Ambient;
            float _Model_Weight;
            float4 _Fx0_Color;
            float _Fx0_Intensity;
            float _Fx0_Power;
            float _Mask0_Threshold;
            float _Mask0_Softness;
            float _Mask0_Invert;
        CBUFFER_END
        TEXTURE2D(_BaseMap); SAMPLER(sampler_BaseMap);
        half4 ProjectLComposerReadBase(ProjectLComposerContext context)
        { return SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, context.uv * _BaseUV.xy + _BaseUV.zw) * _BaseColor; }
        struct ProjectLComposerMasks
        {
            float4 effect0;
        };
        ProjectLComposerMasks ProjectLComposerEvaluateMasks(ProjectLComposerContext context)
        {
            ProjectLComposerMasks result = (ProjectLComposerMasks)0;
            result.effect0.x = saturate(ProjectLLightMask(context.lightBrightness, _Mask0_Threshold, _Mask0_Softness));
            result.effect0.x = lerp(result.effect0.x, 1.0 - result.effect0.x, step(0.5, _Mask0_Invert));
            return result;
        }
        void ProjectLComposerClip(ProjectLComposerMasks masks)
        {
        }
        half3 ProjectLComposerModel0(ProjectLComposerContext context, half3 albedo)
        { return ProjectLComposerHalfLambert(context, albedo, _Model_Power, _Model_Ambient); }
        half3 ProjectLComposerShade(ProjectLComposerContext context, half3 albedo)
        {
            float3 blended = 0; float totalWeight = 0;
            { float weight = max(_Model_Weight, 0.0); if (weight > 0.0) { blended += ProjectLComposerModel0(context, albedo) * weight; totalWeight += weight; } }
            return totalWeight > 0.0 ? blended / max(totalWeight, 1.0e-20) : 0.0.xxx;
        }
        half3 ProjectLComposerApplyEffects(ProjectLComposerContext context, ProjectLComposerMasks masks, half3 color)
        {
            { float4 mask = masks.effect0; color += _Fx0_Color.rgb * _Fx0_Intensity * pow(1.0 - saturate(dot(context.normalWS, context.viewWS)), max(_Fx0_Power, 0.0001)) * mask.x; }
            return color;
        }
        void ProjectLComposerMetaSurface(ProjectLComposerContext context, ProjectLComposerMasks masks, half3 baseColor, out half3 albedo, out half3 emission)
        {
            albedo = baseColor; emission = 0;
        }
        #include "Assets/ProjectL/Script/Render/Shader/Core/Includes/Composer/ComposerPasses.hlsl"
        ENDHLSL
        Pass
        {
            Name "UniversalForward" Tags { "LightMode"="UniversalForward" }
            Cull Back ZWrite [_ZWrite] ZTest LEqual
            Blend [_SrcBlend] [_DstBlend], [_SrcBlendAlpha] [_DstBlendAlpha]
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerVert
            #pragma fragment ProjectLComposerForwardFrag
            #pragma multi_compile_instancing
            #pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE _MAIN_LIGHT_SHADOWS_SCREEN
            #pragma multi_compile _ _ADDITIONAL_LIGHTS_VERTEX _ADDITIONAL_LIGHTS
            #pragma multi_compile_fragment _ _ADDITIONAL_LIGHT_SHADOWS
            #pragma multi_compile_fragment _ _SHADOWS_SOFT _SHADOWS_SOFT_LOW _SHADOWS_SOFT_MEDIUM _SHADOWS_SOFT_HIGH
            #pragma multi_compile_fragment _ _SCREEN_SPACE_OCCLUSION
            #pragma multi_compile_fragment _ _LIGHT_COOKIES
            #pragma multi_compile_fragment _ _LIGHT_LAYERS
            #pragma multi_compile _ _FORWARD_PLUS
            #pragma multi_compile _ LIGHTMAP_ON
            #pragma multi_compile _ DYNAMICLIGHTMAP_ON
            #pragma multi_compile _ DIRLIGHTMAP_COMBINED
            #pragma multi_compile _ LIGHTMAP_SHADOW_MIXING
            #pragma multi_compile _ SHADOWS_SHADOWMASK
            #pragma multi_compile_fog
            ENDHLSL
        }
        Pass
        {
            Name "ShadowCaster" Tags { "LightMode"="ShadowCaster" }
            Cull Back ZWrite On ZTest LEqual ColorMask 0
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerShadowVert
            #pragma fragment ProjectLComposerShadowFrag
            #pragma multi_compile_instancing
            #pragma multi_compile_vertex _ _CASTING_PUNCTUAL_LIGHT_SHADOW
            ENDHLSL
        }
        Pass
        {
            Name "DepthOnly" Tags { "LightMode"="DepthOnly" }
            Cull Back ZWrite On ZTest LEqual ColorMask R
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerVert
            #pragma fragment ProjectLComposerDepthFrag
            #pragma multi_compile_instancing
            ENDHLSL
        }
        Pass
        {
            Name "DepthNormals" Tags { "LightMode"="DepthNormals" }
            Cull Back ZWrite On ZTest LEqual
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerVert
            #pragma fragment ProjectLComposerDepthNormalsFrag
            #pragma multi_compile_instancing
            #pragma multi_compile_fragment _ _GBUFFER_NORMALS_OCT
            #include_with_pragmas "Packages/com.unity.render-pipelines.universal/ShaderLibrary/RenderingLayers.hlsl"
            ENDHLSL
        }
        Pass
        {
            Name "NormalOnly" Tags { "LightMode"="NormalOnly" }
            Cull Back ZWrite On ZTest LEqual
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerVert
            #pragma fragment ProjectLComposerNormalFrag
            #pragma multi_compile_instancing
            ENDHLSL
        }
        Pass
        {
            Name "Meta" Tags { "LightMode"="Meta" }
            Cull Off ZWrite On ZTest LEqual
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerMetaVert
            #pragma fragment ProjectLComposerMetaFrag
            #pragma multi_compile_instancing
            #pragma shader_feature EDITOR_VISUALIZATION
            ENDHLSL
        }
    }
}
