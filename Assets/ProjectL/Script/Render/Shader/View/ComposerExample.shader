// ProjectLShaderComposerRecipe: 
Shader "ProjectL/Generated/ComposerExample"
{
    Properties
    {
        _BaseColor ("기본색", Color) = (1,1,1,1)
        [NoScaleOffset] _BaseMap ("기본 텍스처", 2D) = "white" {}
        _BaseUV ("텍스처 타일링/이동", Vector) = (1,1,0,0)
        _Model_Steps ("명암 단계", Range(2,6)) = 4
        _Model_Dark ("어두운 밝기", Range(0,1)) = 0.05
        _Model_Softness ("경계 부드러움", Range(0,0.1)) = 0
        _Model_Multiplier ("노멀 라이팅 배율", Range(0,8)) = 1
        _Model_Ambient ("환경광 강도", Range(0,1)) = 0.15
        _Model_Metallic ("금속성", Range(0,1)) = 0
        _Model_Smoothness ("매끄러움", Range(0,1)) = 0.5
        [HDR] _Model_SpecularColor ("반사광 색", Color) = (1,1,1,1)
        _Model_SpecularIntensity ("반사광 강도", Range(0,10)) = 0
        _Fx0_Color ("효과 1 / 곱할 색", Color) = (1,1,1,1)
        _Fx0_Strength ("효과 1 / 강도", Range(0,1)) = 1
        [Enum(X,0,Y,1,Z,2)] _Mask0_Axis ("효과 1 / 마스크 / 축", Float) = 1
        _Mask0_Bottom ("효과 1 / 마스크 / 시작 높이", Float) = -0.5
        _Mask0_Top ("효과 1 / 마스크 / 끝 높이", Float) = 0.5
        [Toggle] _Mask0_Invert ("효과 1 / 마스크 / 반전", Float) = 0
        [HDR] _Fx1_Color ("효과 2 / 발광 색", Color) = (0,0.6,1,1)
        _Fx1_Intensity ("효과 2 / 발광 강도", Range(0,20)) = 1
        _Mask1_Scale ("효과 2 / 마스크 / 노이즈 크기", Range(0.1,100)) = 8
        _Mask1_Speed ("효과 2 / 마스크 / 흐르는 속도", Vector) = (0.1,0,0,0)
        _Mask1_Threshold ("효과 2 / 마스크 / 기준값", Range(0,1)) = 0.5
        _Mask1_Softness ("효과 2 / 마스크 / 부드러움", Range(0,0.5)) = 0.1
        [Toggle] _Mask1_Invert ("효과 2 / 마스크 / 반전", Float) = 0
        [HDR] _Fx2_Color ("효과 3 / 림 색", Color) = (1,1,1,1)
        _Fx2_Intensity ("효과 3 / 림 강도", Range(0,20)) = 1
        _Fx2_Power ("효과 3 / 림 폭", Range(0.1,12)) = 3
        [Enum(X,0,Y,1,Z,2)] _Mask2_Axis ("효과 3 / 마스크 / 축", Float) = 1
        _Mask2_Center ("효과 3 / 마스크 / 중심", Float) = 0
        _Mask2_Thickness ("효과 3 / 마스크 / 중앙 두께", Range(0,10)) = 0.2
        _Mask2_LowerFade ("효과 3 / 마스크 / 아래 페이드", Range(0,10)) = 0.2
        _Mask2_UpperFade ("효과 3 / 마스크 / 위 페이드", Range(0,10)) = 0.2
        [Toggle] _Mask2_Invert ("효과 3 / 마스크 / 반전", Float) = 0
        _Fx3_Amount ("효과 4 / 디졸브 양", Range(0,1)) = 0.35
        _Fx3_EdgeWidth ("효과 4 / 테두리 폭", Range(0,0.5)) = 0.05
        [HDR] _Fx3_EdgeColor ("효과 4 / 테두리 색", Color) = (1,0.3,0.02,1)
        _Fx3_EdgeIntensity ("효과 4 / 테두리 발광", Range(0,20)) = 2
        [NoScaleOffset] _Mask3_Texture ("효과 4 / 마스크 / 마스크 텍스처", 2D) = "white" {}
        _Mask3_UV ("효과 4 / 마스크 / 타일링/이동", Vector) = (1,1,0,0)
        [Enum(R,0,G,1,B,2,A,3)] _Mask3_Channel ("효과 4 / 마스크 / 읽을 채널", Float) = 0
        [Toggle] _Mask3_Invert ("효과 4 / 마스크 / 반전", Float) = 0
    }
    SubShader
    {
        Tags { "RenderPipeline"="UniversalPipeline" "RenderType"="TransparentCutout" "Queue"="AlphaTest" }
        HLSLINCLUDE
        #include "Assets/ProjectL/Script/Render/Shader/Core/Includes/Composer/ComposerLighting.hlsl"
        CBUFFER_START(UnityPerMaterial)
            float4 _BaseColor;
            float4 _BaseUV;
            float _Model_Steps;
            float _Model_Dark;
            float _Model_Softness;
            float _Model_Multiplier;
            float _Model_Ambient;
            float _Model_Metallic;
            float _Model_Smoothness;
            float4 _Model_SpecularColor;
            float _Model_SpecularIntensity;
            float4 _Fx0_Color;
            float _Fx0_Strength;
            float _Mask0_Axis;
            float _Mask0_Bottom;
            float _Mask0_Top;
            float _Mask0_Invert;
            float4 _Fx1_Color;
            float _Fx1_Intensity;
            float _Mask1_Scale;
            float4 _Mask1_Speed;
            float _Mask1_Threshold;
            float _Mask1_Softness;
            float _Mask1_Invert;
            float4 _Fx2_Color;
            float _Fx2_Intensity;
            float _Fx2_Power;
            float _Mask2_Axis;
            float _Mask2_Center;
            float _Mask2_Thickness;
            float _Mask2_LowerFade;
            float _Mask2_UpperFade;
            float _Mask2_Invert;
            float _Fx3_Amount;
            float _Fx3_EdgeWidth;
            float4 _Fx3_EdgeColor;
            float _Fx3_EdgeIntensity;
            float4 _Mask3_UV;
            float _Mask3_Channel;
            float _Mask3_Invert;
        CBUFFER_END
        TEXTURE2D(_BaseMap); SAMPLER(sampler_BaseMap);
        TEXTURE2D(_Mask3_Texture); SAMPLER(sampler_Mask3_Texture);
        half4 ProjectLComposerReadBase(ProjectLComposerContext context)
        { return SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, context.uv * _BaseUV.xy + _BaseUV.zw) * _BaseColor; }
        struct ProjectLComposerMasks
        {
            float4 effect0;
            float4 effect1;
            float4 effect2;
            float4 effect3;
        };
        ProjectLComposerMasks ProjectLComposerEvaluateMasks(ProjectLComposerContext context)
        {
            ProjectLComposerMasks result = (ProjectLComposerMasks)0;
            result.effect0.x = saturate(ProjectLComposerHeight(context.positionOS[(int)clamp(_Mask0_Axis, 0, 2)], _Mask0_Bottom, _Mask0_Top));
            result.effect0.x = lerp(result.effect0.x, 1.0 - result.effect0.x, step(0.5, _Mask0_Invert));
            result.effect1.x = saturate(ProjectLNoiseMask(ProjectLComposerNoise(context.uv * _Mask1_Scale + _Time.y * _Mask1_Speed.xy), _Mask1_Threshold, _Mask1_Softness));
            result.effect1.x = lerp(result.effect1.x, 1.0 - result.effect1.x, step(0.5, _Mask1_Invert));
            result.effect2.x = saturate(ProjectLLinearBandMask(context.positionOS[(int)clamp(_Mask2_Axis, 0, 2)], _Mask2_Center, _Mask2_Thickness, _Mask2_LowerFade, _Mask2_UpperFade, 0, 0));
            result.effect2.x = lerp(result.effect2.x, 1.0 - result.effect2.x, step(0.5, _Mask2_Invert));
            result.effect3.x = saturate(SAMPLE_TEXTURE2D(_Mask3_Texture, sampler_Mask3_Texture, context.uv * _Mask3_UV.xy + _Mask3_UV.zw)[(int)clamp(_Mask3_Channel, 0, 3)]);
            result.effect3.x = lerp(result.effect3.x, 1.0 - result.effect3.x, step(0.5, _Mask3_Invert));
            result.effect3.yz = ProjectLDissolveMask(result.effect3.x, _Fx3_Amount, _Fx3_EdgeWidth);
            return result;
        }
        void ProjectLComposerClip(ProjectLComposerMasks masks)
        {
            clip(masks.effect3.y - 0.5);
        }
        half3 ProjectLComposerShade(ProjectLComposerContext context, half3 albedo)
        {
            return ProjectLComposerToon(context, albedo, _Model_Metallic, _Model_Smoothness, _Model_SpecularColor.rgb, _Model_SpecularIntensity, _Model_Steps, _Model_Dark, _Model_Softness, _Model_Multiplier, _Model_Ambient);
        }
        half3 ProjectLComposerApplyEffects(ProjectLComposerContext context, ProjectLComposerMasks masks, half3 color)
        {
            { float4 mask = masks.effect0; color *= lerp(1.0.xxx, _Fx0_Color.rgb, saturate(mask.x * _Fx0_Strength)); }
            { float4 mask = masks.effect1; color += _Fx1_Color.rgb * _Fx1_Intensity * mask.x; }
            { float4 mask = masks.effect2; color += _Fx2_Color.rgb * _Fx2_Intensity * pow(1.0 - saturate(dot(context.normalWS, context.viewWS)), max(_Fx2_Power, 0.0001)) * mask.x; }
            { float4 mask = masks.effect3; color = lerp(color, _Fx3_EdgeColor.rgb * _Fx3_EdgeIntensity, mask.z); }
            return color;
        }
        void ProjectLComposerMetaSurface(ProjectLComposerContext context, ProjectLComposerMasks masks, half3 baseColor, out half3 albedo, out half3 emission)
        {
            albedo = baseColor; emission = 0;
            { float4 mask = masks.effect0; float3 tint = lerp(1.0.xxx, _Fx0_Color.rgb, saturate(mask.x * _Fx0_Strength)); albedo *= tint; emission *= tint; }
            { float4 mask = masks.effect1; emission += _Fx1_Color.rgb * _Fx1_Intensity * mask.x; }
            { float4 mask = masks.effect3; albedo *= 1.0 - mask.z; emission *= 1.0 - mask.z; emission += _Fx3_EdgeColor.rgb * _Fx3_EdgeIntensity * mask.z; }
        }
        #include "Assets/ProjectL/Script/Render/Shader/Core/Includes/Composer/ComposerPasses.hlsl"
        ENDHLSL
        Pass
        {
            Name "FORWARD" Tags { "LightMode"="UniversalForwardOnly" }
            Cull Back ZWrite On ZTest LEqual 
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerVert
            #pragma fragment ProjectLComposerForwardFrag
            #pragma multi_compile_instancing
            #pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE _MAIN_LIGHT_SHADOWS_SCREEN
            #pragma multi_compile _ _ADDITIONAL_LIGHTS_VERTEX _ADDITIONAL_LIGHTS
            #pragma multi_compile_fragment _ _ADDITIONAL_LIGHT_SHADOWS
            #pragma multi_compile_fragment _ _SHADOWS_SOFT _SHADOWS_SOFT_LOW _SHADOWS_SOFT_MEDIUM _SHADOWS_SOFT_HIGH
            #pragma multi_compile_fragment _ _SCREEN_SPACE_OCCLUSION
            #pragma multi_compile_fragment _ _LIGHT_COOKIES
            #pragma multi_compile_fragment _ _LIGHT_LAYERS
            #pragma multi_compile _ _FORWARD_PLUS
            #pragma multi_compile _ LIGHTMAP_ON
            #pragma multi_compile _ DYNAMICLIGHTMAP_ON
            #pragma multi_compile _ DIRLIGHTMAP_COMBINED
            #pragma multi_compile _ LIGHTMAP_SHADOW_MIXING
            #pragma multi_compile _ SHADOWS_SHADOWMASK
            #pragma multi_compile_fog
            ENDHLSL
        }
        Pass
        {
            Name "SHADOWCASTER" Tags { "LightMode"="ShadowCaster" }
            Cull Back ZWrite On ZTest LEqual ColorMask 0
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerShadowVert
            #pragma fragment ProjectLComposerShadowFrag
            #pragma multi_compile_instancing
            #pragma multi_compile_vertex _ _CASTING_PUNCTUAL_LIGHT_SHADOW
            ENDHLSL
        }
        Pass
        {
            Name "DEPTHONLY" Tags { "LightMode"="DepthOnly" }
            Cull Back ZWrite On ZTest LEqual ColorMask R
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerVert
            #pragma fragment ProjectLComposerDepthFrag
            #pragma multi_compile_instancing
            ENDHLSL
        }
        Pass
        {
            Name "DEPTHNORMALS" Tags { "LightMode"="DepthNormalsOnly" }
            Cull Back ZWrite On ZTest LEqual 
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerVert
            #pragma fragment ProjectLComposerDepthNormalsFrag
            #pragma multi_compile_instancing
            #pragma multi_compile_fragment _ _GBUFFER_NORMALS_OCT
            #include_with_pragmas "Packages/com.unity.render-pipelines.universal/ShaderLibrary/RenderingLayers.hlsl"
            ENDHLSL
        }
        Pass
        {
            Name "NORMALONLY" Tags { "LightMode"="NormalOnly" }
            Cull Back ZWrite On ZTest LEqual 
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerVert
            #pragma fragment ProjectLComposerNormalFrag
            #pragma multi_compile_instancing
            ENDHLSL
        }
        Pass
        {
            Name "META" Tags { "LightMode"="Meta" }
            Cull Off ZWrite On ZTest LEqual 
            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ProjectLComposerMetaVert
            #pragma fragment ProjectLComposerMetaFrag
            #pragma multi_compile_instancing
            #pragma shader_feature EDITOR_VISUALIZATION
            ENDHLSL
        }
    }
}
